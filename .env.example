# ==============================================================================
# OMNI SUPER PLATFORM — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual production credentials
# ==============================================================================

# Telegram Bot Configuration (Obtained from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Security & Runtime Settings
APP_ENV=production
SECURITY_MAX_PAYLOAD_MB=50
SSRF_PROTECTION_ENABLED=true
TEMP_DIR=omnibot/temp_workspace

# Server Port Configuration
PORT=8000
